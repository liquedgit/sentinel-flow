# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/sentinel_flow

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_REQUEST_LOGS=sf-events-access
KAFKA_TOPIC_SCAN_REQUESTS=scan-requests
KAFKA_GROUP_ID=detection-engine

# Scan parameters
LEARNING_WINDOW_DAYS=90
VIOLATION_THRESHOLD_PERCENT=5
MINIMUM_SAMPLE_SIZE=100
