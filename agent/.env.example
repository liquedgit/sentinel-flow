# Backend URL to proxy requests to
BACKEND_URL=http://localhost:8081

# Address to listen on
LISTEN_ADDR=:9000

# Kafka brokers (comma-separated; use kafka:9092 when running agent in Docker)
KAFKA_BROKERS=localhost:9092

# Kafka topic for access events
KAFKA_TOPIC=sf-events-access

# Identity endpoint for /me resolution (defaults to BACKEND_URL/me if not set)
ME_ENDPOINT=http://localhost:8081/me
