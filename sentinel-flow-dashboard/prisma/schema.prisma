// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  role      String    @default("view-only")

  resolvedViolations Violation[]
}

model Organization {
  organizationName String    @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
}

// Request logs (high volume, time-partitioned)
model RequestLog {
  id             BigInt   @id @default(autoincrement())
  timestamp      DateTime
  method         String   @db.VarChar(10)
  path           String   @db.VarChar(500)
  normalizedPath String?  @map("normalized_path") @db.VarChar(500)
  userId         String?  @map("user_id") @db.VarChar(255)
  role           String?  @db.VarChar(100)
  clientIp       String?  @map("client_ip") @db.VarChar(45)
  status         Int?
  traceId        String?  @map("trace_id") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")

  violations Violation[]

  @@map("request_logs")
}

// Learned endpoint-role mappings (one row per path+role)
model EndpointRoleMapping {
  id             Int      @id @default(autoincrement())
  normalizedPath String   @map("normalized_path") @db.VarChar(500)
  allowedRole    String   @map("allowed_role") @db.VarChar(100)
  requestCount   BigInt   @default(0) @map("request_count")
  percentage     Decimal  @default(0) @db.Decimal(5, 2)
  status         String   @default("active") @db.VarChar(20)
  autoGenerated  Boolean  @default(true) @map("auto_generated")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([normalizedPath, allowedRole])
  @@map("endpoint_role_mappings")
}

// Detected violations
model Violation {
  id             Int       @id @default(autoincrement())
  timestamp      DateTime
  normalizedPath String    @map("normalized_path") @db.VarChar(500)
  userId         String?   @map("user_id") @db.VarChar(255)
  role           String?   @db.VarChar(100)
  expectedRoles  Json?     @map("expected_roles")
  status         String    @default("new") @db.VarChar(20)
  resolvedById   String?   @map("resolved_by")
  resolvedAt     DateTime? @map("resolved_at")
  requestLogId   BigInt?   @map("request_log_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  requestLog       RequestLog?       @relation(fields: [requestLogId], references: [id])
  resolvedByUser   User?             @relation(fields: [resolvedById], references: [id])
  aiCheckerRequests AICheckerRequest[]

  @@map("violations")
}

// AI checker requests for deep code analysis
model AICheckerRequest {
  id                 String    @id @default(uuid())
  violationId        Int       @map("violation_id")
  status             String    @db.VarChar(20) // "failed" | "running"
  isViolation        Boolean?  @map("is_violation")
  description        String?   @db.Text
  shortDescription   String?   @map("short_description") @db.VarChar(500)
  impact             String?   @db.Text
  recommendationFix  String?   @map("recommendation_fix") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")

  violation Violation @relation(fields: [violationId], references: [id])
  @@map("ai_checker_requests")
}

// System configuration
model Configuration {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.VarChar(255)

  @@map("configurations")
}

model Agent {
  id               String    @id @default(uuid())
  name             String
  identityEndpoint String
  backendBaseUrl   String
  token            String    @unique
  identityMapping  Json
  lastHeartbeat    DateTime? @map("last_heartbeat")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
}

// Audit log
model AuditLog {
  id         String   @id @default(uuid())
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(255)
  userId     String?  @map("user_id") @db.VarChar(255)
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
